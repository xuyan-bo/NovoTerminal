{
  "name": "omnidesk",
  "version": "0.1.0",
  "description": "OmniDesk — local-first remote desktop client (Windows first)",
  "main": "electron/main.js",
  "author": "OmniDesk <xuyanbo.c@qq.com>",
  "homepage": "https://gitee.com/xu-san333/omni-desk",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:auth:mac": "node scripts/build-mac-auth.cjs",
    "preelectron": "node scripts/build-mac-auth.cjs",
    "electron": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "prestart": "node scripts/build-mac-auth.cjs",
    "start": "npm run build:renderer && electron .",
    "pack:mac": "npm run build:renderer && electron-builder --mac",
    "pack:win": "npm run build:renderer && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win --x64",
    "pack:linux": "npm run build:renderer && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --linux --x64",
    "lint": "echo \"no lint configured\""
  },
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "echarts": "^6.1.0",
    "element-ui": "^2.15.14",
    "iconv-lite": "0.6.3",
    "ironrdp-wasm": "^1.1.0",
    "ssh2": "^1.17.0",
    "vue": "^2.7.16",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.3",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.omnidesk.app",
    "productName": "OmniDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "beforePack": "./scripts/build-mac-auth.cjs",
    "mac": {
      "target": ["dmg", "zip"],
      "extraResources": [
        { "from": "build/auth/omnidesk-auth", "to": "auth/omnidesk-auth" }
      ],
      "binaries": ["Contents/Resources/auth/omnidesk-auth"]
    },
    "win": {
      "target": [
        "nsis",
        "7z"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": ["deb", "rpm"],
      "icon": "build/icon.png",
      "category": "Network"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {}
}
