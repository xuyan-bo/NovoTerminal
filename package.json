{
  "name": "novoterminal",
  "version": "0.1.0",
  "description": "Thinking operations terminal for SSH, VNC and RDP with SFTP file transfer",
  "main": "electron/main.js",
  "author": "NovoTerminal <xuyanbo.c@qq.com>",
  "homepage": "https://gitee.com/xu-san333/omni-desk",
  "githubHomepage": "https://github.com/xuyan-bo/OmniDesk",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:auth:mac": "node scripts/build-mac-auth.cjs",
    "preelectron": "node scripts/build-mac-auth.cjs",
    "electron": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "prestart": "node scripts/build-mac-auth.cjs",
    "start": "npm run build:renderer && electron .",
    "pack:mac": "npm run build:renderer && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --mac --arm64 --x64",
    "pack:win": "npm run build:renderer && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win --x64 --arm64",
    "pack:linux": "npm run build:renderer && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --linux --x64 --arm64",
    "lint": "echo \"no lint configured\""
  },
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "echarts": "^6.1.0",
    "element-ui": "^2.15.14",
    "iconv-lite": "0.6.3",
    "ironrdp-wasm": "^1.1.0",
    "openai": "^4.98.0",
    "ssh2": "^1.17.0",
    "vue": "^2.7.16",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.3",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "marked": "^18.0.14",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.novoterminal.app",
    "productName": "NovoTerminal",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "beforePack": "./scripts/build-mac-auth.cjs",
    "mac": {
      "target": [
        "dmg",
        "zip",
        { "target": "pkg", "arch": ["universal"] }
      ],
      "minimumSystemVersion": "11.0",
      "extraResources": [
        { "from": "build/auth/novoterminal-auth", "to": "auth/novoterminal-auth" }
      ],
      "binaries": ["Contents/Resources/auth/novoterminal-auth"]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": ["deb", "rpm", "AppImage", "tar.xz"],
      "icon": "build/icon.png",
      "category": "Network",
      "synopsis": "Thinking ops terminal with SSH, VNC, RDP and SFTP",
      "description": "NovoTerminal is a thinking operations terminal: SSH, VNC and RDP sessions, SFTP file transfer, per-host monitoring and a built-in AI assistant. Asset data stays on this machine."
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  },
  "allowScripts": {}
}
